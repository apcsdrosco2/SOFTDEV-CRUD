@model IEnumerable<StudentManagement.ViewModels.FlightDto>
@{
    ViewData["Title"] = "Flights";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-airplane-engines"></i> Flights</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add New Flight
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle shadow-sm bg-white">
        <thead class="table-dark">
            <tr>
                <th>Flight #</th>
                <th>Route</th>
                <th>Departure</th>
                <th>Seat Class</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flight in Model)
            {
                <tr>
                    <td>@flight.FlightNumber</td>
                    <td>@flight.Origin → @flight.Destination</td>
                    <td>@flight.DepartureDate.ToString("g")</td>
                    <td>@flight.SeatClass</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@flight.FlightId" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@flight.FlightId" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No flights found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
